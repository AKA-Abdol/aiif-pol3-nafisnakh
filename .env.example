# ============================================================ LLM profiles
# NN_LLM_PROFILE picks the generation backend: `gemini` (default, PLAN Q3) or
# `agentrouter`. Adding a backend means adding a profile in config.py — never
# editing the gemini one.
NN_LLM_PROFILE=gemini

# profile: gemini — google/gemini-2.0-flash-001 via OpenRouter
OPENROUTER_API_KEY=

# profile: agentrouter — gpt-5.6-sol via https://agentrouter.org/v1
AGENTROUTER_API_KEY=

NN_LLM_TEMPERATURE=0.0

# --- embeddings (Ollama, local) ------------------------------------------
NN_OLLAMA_HOST=http://localhost:11434
NN_EMBED_MODEL=bge-m3:567m

# --- run parameters -------------------------------------------------------
NN_AS_OF=2021-06-30
NN_DATASET_PATH=DATASET.xlsx
NN_METADATA_PATH=METADATA.xlsx
