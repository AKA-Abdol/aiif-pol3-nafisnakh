# --- generation (OpenRouter via LangChain) -------------------------------
# Q14: key supplied by the user later. Until then LLM blocks run in offline
# mode against recorded fixtures and never make a live call.
OPENROUTER_API_KEY=
NN_LLM_BASE_URL=https://openrouter.ai/api/v1
NN_LLM_MODEL=google/gemini-2.0-flash-001
NN_LLM_TEMPERATURE=0.0

# --- embeddings (Ollama, local) ------------------------------------------
NN_OLLAMA_HOST=http://localhost:11434
NN_EMBED_MODEL=bge-m3:567m
# quality option: qwen3-embedding:8b-q8_0

# --- run parameters -------------------------------------------------------
NN_AS_OF=2021-06-30
NN_DATASET_PATH=DATASET.xlsx
NN_METADATA_PATH=METADATA.xlsx
