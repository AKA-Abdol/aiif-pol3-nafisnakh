# ============================================================ LLM (OpenRouter)
# Every LLM call in this system goes through OpenRouter. NN_LLM_PROFILE selects a
# named backend from config.py; `gemini` is the only one, and adding another means
# adding a profile there — never editing this one.
NN_LLM_PROFILE=gemini

OPENROUTER_API_KEY=

# Model and provider pin. NN_LLM_PROVIDER_ONLY is OpenRouter's provider routing:
# comma-separated endpoint tags the request may land on, most preferred first.
# Valid tags for a model: GET /api/v1/models/<model>/endpoints — for
# google/gemini-3.7-flash they are google-vertex/global (+/flex, /priority) and
# google-ai-studio. Leave empty to let OpenRouter choose.
NN_LLM_MODEL=google/gemini-3.7-flash
NN_LLM_PROVIDER_ONLY=google-vertex/global
NN_LLM_TEMPERATURE=0.0

# --- embeddings -----------------------------------------------------------
# NN_EMBED_BACKEND: `openrouter` (uses OPENROUTER_API_KEY above) or `ollama`
# (local daemon, free and offline). Both defaults are the same bge-m3 model at
# 1024 dims, so switching backends does not move the vector geometry.
NN_EMBED_BACKEND=openrouter
NN_OPENROUTER_EMBED_MODEL=baai/bge-m3
NN_OLLAMA_HOST=http://localhost:11434
NN_EMBED_MODEL=bge-m3:567m

# --- run parameters -------------------------------------------------------
NN_AS_OF=2021-06-30
NN_DATASET_PATH=DATASET.xlsx
NN_METADATA_PATH=METADATA.xlsx
